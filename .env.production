# ======================================
# 期权交易策略系统 - 生产环境配置
# ======================================

# 数据库配置
DATABASE_URL=sqlite:///./data/option_tracker.db

# ======================================
# 数据源API配置
# ======================================

# 优矿API Token (必填)
# 获取方式: https://uqer.datayes.com/
UQER_TOKEN=190bbd239ab55cb2f3f2919601622b0b793e94c35d7967e0c4b325682eddd981

# 交易可查账号 (选填 - 用于资金面数据)
JYK_USER=
JYK_PASS=

# ======================================
# AI集成配置 (选填)
# ======================================

# Gemini AI配置
GEMINI_API_KEY=
GEMINI_BASE_URL=https://www.apillm.online/v1

# ======================================
# 应用配置
# ======================================

# 调试模式 (生产环境设为False)
DEBUG=False

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 服务端口
PORT=8000

# ======================================
# 安全配置 (生产环境建议设置)
# ======================================

# 允许的CORS域名 (逗号分隔,* 表示允许所有)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# JWT密钥 (如果需要认证)
# SECRET_KEY=your-secret-key-here

# ======================================
# 性能配置
# ======================================

# 工作进程数 (推荐为CPU核心数)
WORKERS=2

# 最大并发连接数
MAX_CONNECTIONS=100
